<!-- S23: ITERTOOLS -->
<div class="section c-blue" id="s23">
  <div class="sec-head"><div class="sec-num">23</div><div class="sec-title">Itertools & Functools</div><span class="sec-emoji">🔗</span></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">itertools_functools.py</span></div>
    <pre><span class="kw">import</span> itertools
<span class="kw">import</span> functools

<span class="cm"># ─── itertools ───</span>
<span class="cm"># chain — multiple iterables jodo</span>
result = <span class="bi">list</span>(itertools.chain([<span class="nm">1</span>,<span class="nm">2</span>], [<span class="nm">3</span>,<span class="nm">4</span>], [<span class="nm">5</span>]))
<span class="cm"># [1, 2, 3, 4, 5]</span>

<span class="cm"># product — Cartesian product</span>
combos = <span class="bi">list</span>(itertools.product(<span class="st">"AB"</span>, [<span class="nm">1</span>,<span class="nm">2</span>]))
<span class="cm"># [('A',1),('A',2),('B',1),('B',2)]</span>

<span class="cm"># combinations — choose r items (order matters nahi)</span>
c = <span class="bi">list</span>(itertools.combinations([<span class="nm">1</span>,<span class="nm">2</span>,<span class="nm">3</span>], <span class="nm">2</span>))
<span class="cm"># [(1,2),(1,3),(2,3)]</span>

<span class="cm"># permutations — order matters</span>
p = <span class="bi">list</span>(itertools.permutations([<span class="nm">1</span>,<span class="nm">2</span>,<span class="nm">3</span>], <span class="nm">2</span>))

<span class="cm"># groupby — group karo</span>
data = [(<span class="st">"A"</span>,<span class="nm">1</span>), (<span class="st">"A"</span>,<span class="nm">2</span>), (<span class="st">"B"</span>,<span class="nm">3</span>)]
<span class="kw">for</span> key, group <span class="kw">in</span> itertools.groupby(data, key=<span class="kw">lambda</span> x: x[<span class="nm">0</span>]):
    <span class="fn">print</span>(key, <span class="bi">list</span>(group))

<span class="cm"># ─── functools ───</span>
<span class="cm"># reduce — sab combine karo</span>
total = functools.reduce(<span class="kw">lambda</span> a,b: a+b, [<span class="nm">1</span>,<span class="nm">2</span>,<span class="nm">3</span>,<span class="nm">4</span>])
<span class="cm"># 10</span>

<span class="cm"># lru_cache — memoization (slow recursion fast karo)</span>
<span class="dec">@functools.lru_cache</span>(maxsize=<span class="kw">None</span>)
<span class="kw">def</span> <span class="fn">fib</span>(n):
    <span class="kw">if</span> n <= <span class="nm">1</span>: <span class="kw">return</span> n
    <span class="kw">return</span> fib(n-<span class="nm">1</span>) + fib(n-<span class="nm">2</span>)

<span class="fn">print</span>(fib(<span class="nm">50</span>))   <span class="cm"># bahut fast! (cache ki wajah se)</span>

<span class="cm"># partial — function ke kuch args fix karo</span>
<span class="kw">from</span> functools <span class="kw">import</span> partial
power = <span class="kw">lambda</span> base, exp: base ** exp
