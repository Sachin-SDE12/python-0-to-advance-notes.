<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Python 0 to Advanced – Complete Notes</title>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0b0d13;
  --surface: #11141f;
  --card: #161a27;
  --border: #1f2438;
  --py-blue: #4b8bbe;
  --py-yellow: #ffd43b;
  --green: #4ade80;
  --pink: #f472b6;
  --purple: #a78bfa;
  --orange: #fb923c;
  --cyan: #22d3ee;
  --red: #f87171;
  --text: #dde3f0;
  --muted: #6b7594;
  --code-bg: #080a10;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  line-height: 1.75;
}

/* ─── HERO ─── */
.hero {
  text-align: center;
  padding: 60px 20px 50px;
  background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(75,139,190,.18) 0%, transparent 70%),
              radial-gradient(ellipse 40% 40% at 80% 100%, rgba(167,139,250,.08) 0%, transparent 60%);
  border-bottom: 1px solid var(--border);
  position: relative;
}
.hero-snake { font-size: 72px; display: block; margin-bottom: 10px; animation: bob 3s ease-in-out infinite; }
@keyframes bob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
.hero h1 { font-size: clamp(30px,7vw,58px); font-weight: 800; letter-spacing: -1px; }
.grad-text { background: linear-gradient(120deg, var(--py-yellow) 0%, var(--py-blue) 60%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.hero-sub { color: var(--muted); margin-top: 8px; font-size: 15px; font-weight: 300; }
.badges { display:flex; gap:8px; justify-content:center; margin-top:18px; flex-wrap:wrap; }
.badge { padding:4px 14px; border-radius:99px; font-size:12px; font-weight:600; }
.badge-b { background:rgba(74,222,128,.1); border:1px solid rgba(74,222,128,.3); color:var(--green); }
.badge-i { background:rgba(251,146,60,.1); border:1px solid rgba(251,146,60,.3); color:var(--orange); }
.badge-a { background:rgba(167,139,250,.1); border:1px solid rgba(167,139,250,.3); color:var(--purple); }

/* ─── STICKY NAV ─── */
.toc {
  position: sticky; top:0; z-index:200;
  background: rgba(11,13,19,.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 0 12px;
  overflow-x: auto;
  white-space: nowrap;
  scrollbar-width: none;
}
.toc::-webkit-scrollbar { display:none; }
.toc-inner { display:inline-flex; gap:2px; padding:8px 0; }
.toc a {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 12px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  color: var(--muted);
  transition: all .18s;
  white-space: nowrap;
}
.toc a:hover { background: rgba(255,255,255,.06); color: var(--text); }

/* ─── LAYOUT ─── */
.main { max-width:900px; margin:0 auto; padding:36px 16px 80px; }

/* ─── LEVEL BANNERS ─── */
.level-banner {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 20px;
  border-radius: 10px;
  margin: 36px 0 24px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.level-beginner { background:rgba(74,222,128,.07); border:1px solid rgba(74,222,128,.2); color:var(--green); }
.level-intermediate { background:rgba(251,146,60,.07); border:1px solid rgba(251,146,60,.2); color:var(--orange); }
.level-advanced { background:rgba(167,139,250,.07); border:1px solid rgba(167,139,250,.2); color:var(--purple); }
.level-dot { width:8px; height:8px; border-radius:50%; background:currentColor; }

/* ─── SECTION ─── */
.section { scroll-margin-top:70px; margin-bottom:40px; }
.sec-head {
  display:flex; align-items:center; gap:12px;
  padding-bottom:12px; border-bottom:1px solid var(--border);
  margin-bottom:18px;
}
.sec-num {
  min-width:36px; height:36px;
  border-radius:10px;
  display:flex; align-items:center; justify-content:center;
  font-family:'Fira Code',monospace; font-size:12px; font-weight:600;
}
.sec-title { font-size:22px; font-weight:700; letter-spacing:-.3px; }
.sec-emoji { font-size:22px; }

/* Colour theming helpers */
.c-yellow .sec-num { background:rgba(255,212,59,.12); color:var(--py-yellow); }
.c-yellow .sec-title { color:var(--py-yellow); }
.c-blue .sec-num { background:rgba(75,139,190,.12); color:var(--py-blue); }
.c-blue .sec-title { color:var(--py-blue); }
.c-green .sec-num { background:rgba(74,222,128,.12); color:var(--green); }
.c-green .sec-title { color:var(--green); }
.c-pink .sec-num { background:rgba(244,114,182,.12); color:var(--pink); }
.c-pink .sec-title { color:var(--pink); }
.c-purple .sec-num { background:rgba(167,139,250,.12); color:var(--purple); }
.c-purple .sec-title { color:var(--purple); }
.c-orange .sec-num { background:rgba(251,146,60,.12); color:var(--orange); }
.c-orange .sec-title { color:var(--orange); }
.c-cyan .sec-num { background:rgba(34,211,238,.12); color:var(--cyan); }
.c-cyan .sec-title { color:var(--cyan); }
.c-red .sec-num { background:rgba(248,113,113,.12); color:var(--red); }
.c-red .sec-title { color:var(--red); }

/* ─── CARD ─── */
.card { background:var(--card); border:1px solid var(--border); border-radius:12px; padding:18px 20px; margin-bottom:14px; }
.card p+p { margin-top:8px; }
.card-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--muted); margin-bottom:10px; }

/* ─── CODE BLOCK ─── */
.cb { background:var(--code-bg); border:1px solid var(--border); border-radius:12px; overflow:hidden; margin:12px 0; }
.cb-top { display:flex; align-items:center; gap:7px; padding:8px 14px; background:rgba(255,255,255,.025); border-bottom:1px solid var(--border); }
.dot { width:10px;height:10px;border-radius:50%; }
.dr{background:#ff5f56}.dy{background:#ffbd2e}.dg{background:#27c93f}
.cb-file { font-size:11px; color:var(--muted); margin-left:auto; font-family:'Fira Code',monospace; }
pre { padding:16px; overflow-x:auto; font-family:'Fira Code',monospace; font-size:13px; line-height:1.9; tab-size:4; }
/* Syntax highlight */
.kw{color:#c792ea} .fn{color:#82aaff} .st{color:#c3e88d} .nm{color:#f78c6c}
.cm{color:#3d4f5c;font-style:italic} .op{color:#89ddff} .cl{color:var(--py-yellow)}
.bi{color:var(--pink)} .dec{color:var(--orange)} .err{color:var(--red)}

/* ─── OUTPUT ─── */
.out { background:rgba(74,222,128,.04); border:1px solid rgba(74,222,128,.15); border-radius:8px; padding:12px 16px; font-family:'Fira Code',monospace; font-size:13px; color:var(--green); margin-top:-4px; }
.out-lbl { font-size:11px; color:rgba(74,222,128,.5); font-family:'Outfit',sans-serif; margin-bottom:4px; }

/* ─── INFO BOXES ─── */
.box { border-radius:10px; padding:13px 16px; margin:12px 0; font-size:14px; display:flex; gap:10px; align-items:flex-start; }
.box .ico { font-size:17px; flex-shrink:0; margin-top:2px; }
.tip  { background:rgba(74,222,128,.06); border:1px solid rgba(74,222,128,.2); }
.note { background:rgba(75,139,190,.06); border:1px solid rgba(75,139,190,.2); }
.warn { background:rgba(255,212,59,.06); border:1px solid rgba(255,212,59,.2); }
.danger { background:rgba(248,113,113,.06); border:1px solid rgba(248,113,113,.2); }

/* ─── TABLE ─── */
.tbl { width:100%; border-collapse:collapse; font-size:14px; margin:10px 0; }
.tbl th { background:rgba(255,255,255,.04); padding:9px 13px; text-align:left; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); border-bottom:1px solid var(--border); }
.tbl td { padding:9px 13px; border-bottom:1px solid rgba(255,255,255,.04); vertical-align:top; }
.tbl tr:last-child td { border-bottom:none; }
.tbl td code,.tbl th code { font-family:'Fira Code',monospace; font-size:12px; background:rgba(255,255,255,.07); padding:2px 6px; border-radius:4px; color:var(--py-yellow); }

/* ─── GRID ─── */
.g2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.g3 { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
@media(max-width:600px) { .g2,.g3 { grid-template-columns:1fr; } }

/* ─── INLINE CODE ─── */
ic { font-family:'Fira Code',monospace; font-size:12.5px; background:rgba(255,212,59,.09); color:var(--py-yellow); padding:1px 6px; border-radius:4px; }

/* ─── DIVIDER ─── */
hr { border:none; border-top:1px solid var(--border); margin:8px 0; }

/* ─── FOOTER ─── */
footer { text-align:center; padding:32px; color:var(--muted); font-size:13px; border-top:1px solid var(--border); }
footer b { color:var(--py-yellow); }
</style>
</head>
