<!-- S14: OOP -->
<div class="section c-green" id="s14">
  <div class="sec-head"><div class="sec-num">14</div><div class="sec-title">OOP — Classes & Objects</div><span class="sec-emoji">🏗️</span></div>
  <div class="card"><p><strong>Class</strong> ek blueprint hai. <strong>Object</strong> us blueprint ki real copy hai. OOP se hum real-world cheezein code mein model karte hain.</p></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">oop.py</span></div>
    <pre><span class="kw">class</span> <span class="cl">BankAccount</span>:
    <span class="cm"># Class variable (sab objects ke liye ek hi)</span>
    bank_name = <span class="st">"Python Bank"</span>

    <span class="cm"># Constructor</span>
    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, owner, balance=<span class="nm">0</span>):
        <span class="kw">self</span>.owner   = owner      <span class="cm"># instance variable</span>
        <span class="kw">self</span>.balance = balance

    <span class="cm"># Instance Methods</span>
    <span class="kw">def</span> <span class="fn">deposit</span>(<span class="kw">self</span>, amount):
        <span class="kw">self</span>.balance += amount
        <span class="fn">print</span>(<span class="st">f"✅ ₹{amount} deposit | Balance: ₹{self.balance}"</span>)

    <span class="kw">def</span> <span class="fn">withdraw</span>(<span class="kw">self</span>, amount):
        <span class="kw">if</span> amount > <span class="kw">self</span>.balance:
            <span class="fn">print</span>(<span class="st">"❌ Insufficient balance!"</span>)
        <span class="kw">else</span>:
            <span class="kw">self</span>.balance -= amount
            <span class="fn">print</span>(<span class="st">f"✅ ₹{amount} withdrawn | Balance: ₹{self.balance}"</span>)

    <span class="cm"># String representation</span>
    <span class="kw">def</span> <span class="fn">__str__</span>(<span class="kw">self</span>):
        <span class="kw">return</span> <span class="st">f"Account[{self.owner}] = ₹{self.balance}"</span>

    <span class="cm"># Static method (self nahi chahiye)</span>
    <span class="dec">@staticmethod</span>
    <span class="kw">def</span> <span class="fn">interest_rate</span>():
        <span class="kw">return</span> <span class="nm">4.5</span>

    <span class="cm"># Class method</span>
    <span class="dec">@classmethod</span>
    <span class="kw">def</span> <span class="fn">bank_info</span>(cls):
        <span class="fn">print</span>(<span class="st">f"Bank: {cls.bank_name}"</span>)


<span class="cm"># Objects banana</span>
acc1 = <span class="cl">BankAccount</span>(<span class="st">"Sachin"</span>, <span class="nm">5000</span>)
acc2 = <span class="cl">BankAccount</span>(<span class="st">"Priya"</span>)

acc1.deposit(<span class="nm">2000</span>)
acc1.withdraw(<span class="nm">1000</span>)
<span class="fn">print</span>(acc1)              <span class="cm"># Account[Sachin] = ₹6000</span>

<span class="cl">BankAccount</span>.bank_info()
<span class="fn">print</span>(<span class="cl">BankAccount</span>.interest_rate())</pre>
  </div>
</div>

<!-- S15: INHERITANCE -->
<div class="section c-yellow" id="s15">
  <div class="sec-head"><div class="sec-num">15</div><div class="sec-title">Inheritance & Polymorphism</div><span class="sec-emoji">🧬</span></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">inheritance.py</span></div>
    <pre><span class="cm"># ─── Parent Class ───</span>
<span class="kw">class</span> <span class="cl">Animal</span>:
    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, naam):
        <span class="kw">self</span>.naam = naam

    <span class="kw">def</span> <span class="fn">bolna</span>(<span class="kw">self</span>):
        <span class="kw">return</span> <span class="st">"..."</span>

    <span class="kw">def</span> <span class="fn">info</span>(<span class="kw">self</span>):
        <span class="fn">print</span>(<span class="st">f"{self.naam} kehta hai: {self.bolna()}"</span>)

<span class="cm"># ─── Child Classes ───</span>
<span class="kw">class</span> <span class="cl">Dog</span>(<span class="cl">Animal</span>):
    <span class="kw">def</span> <span class="fn">bolna</span>(<span class="kw">self</span>):       <span class="cm"># Method Override</span>
        <span class="kw">return</span> <span class="st">"Woof! 🐕"</span>

<span class="kw">class</span> <span class="cl">Cat</span>(<span class="cl">Animal</span>):
    <span class="kw">def</span> <span class="fn">bolna</span>(<span class="kw">self</span>):
        <span class="kw">return</span> <span class="st">"Meow! 🐱"</span>

<span class="kw">class</span> <span class="cl">GuideDog</span>(<span class="cl">Dog</span>):        <span class="cm"># Multi-level inheritance</span>
    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, naam, id_num):
        <span class="bi">super</span>().__init__(naam)   <span class="cm"># Parent ka __init__ call karo</span>
        <span class="kw">self</span>.id_num = id_num

    <span class="kw">def</span> <span class="fn">guide</span>(<span class="kw">self</span>):
        <span class="fn">print</span>(<span class="st">f"{self.naam} (ID:{self.id_num}) is guiding 🦮"</span>)

<span class="cm"># ─── Polymorphism ───</span>
animals = [<span class="cl">Dog</span>(<span class="st">"Tommy"</span>), <span class="cl">Cat</span>(<span class="st">"Kitty"</span>), <span class="cl">Dog</span>(<span class="st">"Bruno"</span>)]
<span class="kw">for</span> animal <span class="kw">in</span> animals:
    animal.info()     <span class="cm"># har ek apne tarike se bolega</span>

<span class="cm"># ─── isinstance / issubclass ───</span>
<span class="fn">print</span>(<span class="bi">isinstance</span>(<span class="cl">Dog</span>(<span class="st">"x"</span>), <span class="cl">Animal</span>))   <span class="cm"># True</span>
<span class="fn">print</span>(<span class="bi">issubclass</span>(<span class="cl">Dog</span>, <span class="cl">Animal</span>))        <span class="cm"># True</span>

<span class="cm"># ─── Abstract Class ───</span>
<span class="kw">from</span> abc <span class="kw">import</span> ABC, abstractmethod
<span class="kw">class</span> <span class="cl">Shape</span>(ABC):
    <span class="dec">@abstractmethod</span>
    <span class="kw">def</span> <span class="fn">area</span>(<span class="kw">self</span>): <span class="kw">pass</span>

<span class="kw">class</span> <span class="cl">Circle</span>(<span class="cl">Shape</span>):
    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, r): <span class="kw">self</span>.r = r
    <span class="kw">def</span> <span class="fn">area</span>(<span class="kw">self</span>): <span class="kw">return</span> <span class="nm">3.14</span> * <span class="kw">self</span>.r ** <span class="nm">2</span></pre>
  </div>
</div>

<!-- S16: EXCEPTIONS -->
<div class="section c-red" id="s16">
  <div class="sec-head"><div class="sec-num">16</div><div class="sec-title">Exception Handling</div><span class="sec-emoji">💥</span></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">exceptions.py</span></div>
    <pre><span class="cm"># ─── try / except ───</span>
<span class="kw">try</span>:
    num = <span class="bi">int</span>(<span class="bi">input</span>(<span class="st">"Number likhein: "</span>))
    result = <span class="nm">100</span> / num
    <span class="fn">print</span>(<span class="st">f"Result: {result}"</span>)

<span class="kw">except</span> <span class="bi">ValueError</span>:
