<!-- S6: CONDITIONS -->
<div class="section c-orange" id="s6">
  <div class="sec-head"><div class="sec-num">06</div><div class="sec-title">Conditions — if / elif / else</div><span class="sec-emoji">🔀</span></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">conditions.py</span></div>
    <pre><span class="cm"># Basic if-elif-else</span>
marks = <span class="nm">78</span>

<span class="kw">if</span> marks >= <span class="nm">90</span>:
    <span class="fn">print</span>(<span class="st">"A Grade 🏆"</span>)
<span class="kw">elif</span> marks >= <span class="nm">75</span>:
    <span class="fn">print</span>(<span class="st">"B Grade ✅"</span>)
<span class="kw">elif</span> marks >= <span class="nm">60</span>:
    <span class="fn">print</span>(<span class="st">"C Grade 📚"</span>)
<span class="kw">elif</span> marks >= <span class="nm">40</span>:
    <span class="fn">print</span>(<span class="st">"D Grade ⚠️"</span>)
<span class="kw">else</span>:
    <span class="fn">print</span>(<span class="st">"Fail ❌"</span>)

<span class="cm"># Ternary (one-liner)</span>
result = <span class="st">"Pass"</span> <span class="kw">if</span> marks >= <span class="nm">40</span> <span class="kw">else</span> <span class="st">"Fail"</span>

<span class="cm"># Nested if</span>
age = <span class="nm">20</span>
has_id = <span class="kw">True</span>
<span class="kw">if</span> age >= <span class="nm">18</span>:
    <span class="kw">if</span> has_id:
        <span class="fn">print</span>(<span class="st">"Entry allowed ✅"</span>)
    <span class="kw">else</span>:
        <span class="fn">print</span>(<span class="st">"ID dikhao"</span>)
<span class="kw">else</span>:
    <span class="fn">print</span>(<span class="st">"Nahi aa sakte"</span>)

<span class="cm"># match-case (Python 3.10+) — switch jaisi</span>
day = <span class="st">"Monday"</span>
<span class="kw">match</span> day:
    <span class="kw">case</span> <span class="st">"Monday"</span> | <span class="st">"Tuesday"</span>:
        <span class="fn">print</span>(<span class="st">"Week ka shuruat 😴"</span>)
    <span class="kw">case</span> <span class="st">"Friday"</span>:
        <span class="fn">print</span>(<span class="st">"Friday hai! 🎉"</span>)
    <span class="kw">case</span> _:
        <span class="fn">print</span>(<span class="st">"Normal day"</span>)</pre>
  </div>
  <div class="box warn"><span class="ico">⚠️</span><span><strong>Indentation zaroori hai!</strong> Python mein <ic>{ }</ic> nahi hoti — 4 spaces ya 1 tab se block define hota hai. Galat indentation = error.</span></div>
</div>

<!-- S7: LOOPS -->
<div class="section c-cyan" id="s7">
  <div class="sec-head"><div class="sec-num">07</div><div class="sec-title">Loops — for / while</div><span class="sec-emoji">🔁</span></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">for_loop.py</span></div>
    <pre><span class="cm"># ─── for loop ───</span>
<span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">5</span>):          <span class="cm"># 0,1,2,3,4</span>
    <span class="fn">print</span>(i, end=<span class="st">" "</span>)

<span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">1</span>, <span class="nm">11</span>):      <span class="cm"># 1 to 10</span>
    <span class="fn">print</span>(i, end=<span class="st">" "</span>)

<span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">10</span>, <span class="nm">0</span>, -<span class="nm">1</span>): <span class="cm"># 10 to 1 (ulta)</span>
    <span class="fn">print</span>(i, end=<span class="st">" "</span>)

<span class="cm"># List pe loop</span>
fruits = [<span class="st">"Apple"</span>, <span class="st">"Mango"</span>, <span class="st">"Banana"</span>]
<span class="kw">for</span> fruit <span class="kw">in</span> fruits:
    <span class="fn">print</span>(fruit)

<span class="cm"># Index bhi chahiye? → enumerate</span>
<span class="kw">for</span> idx, fruit <span class="kw">in</span> <span class="bi">enumerate</span>(fruits, start=<span class="nm">1</span>):
    <span class="fn">print</span>(<span class="st">f"{idx}. {fruit}"</span>)

<span class="cm"># Do lists ek saath → zip</span>
names  = [<span class="st">"Ali"</span>, <span class="st">"Sara"</span>, <span class="st">"Raj"</span>]
scores = [<span class="nm">88</span>, <span class="nm">92</span>, <span class="nm">76</span>]
<span class="kw">for</span> name, score <span class="kw">in</span> <span class="bi">zip</span>(names, scores):
    <span class="fn">print</span>(<span class="st">f"{name}: {score}"</span>)</pre>
  </div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">while_loop.py</span></div>
    <pre><span class="cm"># ─── while loop ───</span>
count = <span class="nm">1</span>
<span class="kw">while</span> count <= <span class="nm">5</span>:
    <span class="fn">print</span>(count, end=<span class="st">" "</span>)
    count += <span class="nm">1</span>

<span class="cm"># break — loop band karo</span>
<span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">10</span>):
    <span class="kw">if</span> i == <span class="nm">5</span>: <span class="kw">break</span>
    <span class="fn">print</span>(i, end=<span class="st">" "</span>)    <span class="cm"># 0 1 2 3 4</span>

<span class="cm"># continue — current step skip karo</span>
<span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">6</span>):
    <span class="kw">if</span> i % <span class="nm">2</span> == <span class="nm">0</span>: <span class="kw">continue</span>
    <span class="fn">print</span>(i, end=<span class="st">" "</span>)    <span class="cm"># 1 3 5  (even skip)</span>

<span class="cm"># else with loop (jab loop normally complete ho)</span>
<span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">3</span>):
    <span class="fn">print</span>(i)
<span class="kw">else</span>:
    <span class="fn">print</span>(<span class="st">"Loop complete! ✅"</span>)

<span class="cm"># Nested loops — multiplication table</span>
<span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">1</span>, <span class="nm">4</span>):
    <span class="kw">for</span> j <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">1</span>, <span class="nm">4</span>):
        <span class="fn">print</span>(<span class="st">f"{i}x{j}={i*j}"</span>, end=<span class="st">"  "</span>)
    <span class="fn">print</span>()</pre>
  </div>
</div>

<!-- S8: FUNCTIONS -->
<div class="section c-yellow" id="s8">
  <div class="sec-head"><div class="sec-num">08</div><div class="sec-title">Functions</div><span class="sec-emoji">⚙️</span></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">functions.py</span></div>
    <pre><span class="cm"># ─── Basic Function ───</span>
<span class="kw">def</span> <span class="fn">greet</span>():
    <span class="fn">print</span>(<span class="st">"Namaste! 🙏"</span>)

<span class="cm"># ─── Parameters ───</span>
<span class="kw">def</span> <span class="fn">add</span>(a, b):
    <span class="kw">return</span> a + b

<span class="fn">print</span>(add(<span class="nm">5</span>, <span class="nm">3</span>))     <span class="cm"># 8</span>

<span class="cm"># ─── Default Parameter ───</span>
<span class="kw">def</span> <span class="fn">power</span>(base, exp=<span class="nm">2</span>):
    <span class="kw">return</span> base ** exp

<span class="fn">print</span>(power(<span class="nm">4</span>))       <span class="cm"># 16  (exp=2 default)</span>
<span class="fn">print</span>(power(<span class="nm">2</span>, <span class="nm">10</span>))   <span class="cm"># 1024</span>

<span class="cm"># ─── Keyword Arguments ───</span>
<span class="kw">def</span> <span class="fn">student_info</span>(naam, marks, city=<span class="st">"Delhi"</span>):
    <span class="fn">print</span>(<span class="st">f"{naam} | {marks} | {city}"</span>)

student_info(marks=<span class="nm">90</span>, naam=<span class="st">"Sara"</span>)

<span class="cm"># ─── *args (variable positional args) ───</span>
<span class="kw">def</span> <span class="fn">total</span>(*nums):
    <span class="kw">return</span> <span class="bi">sum</span>(nums)

<span class="fn">print</span>(total(<span class="nm">1</span>, <span class="nm">2</span>, <span class="nm">3</span>, <span class="nm">4</span>, <span class="nm">5</span>))   <span class="cm"># 15</span>

<span class="cm"># ─── **kwargs (variable keyword args) ───</span>
<span class="kw">def</span> <span class="fn">profile</span>(**info):
    <span class="kw">for</span> key, val <span class="kw">in</span> info.items():
        <span class="fn">print</span>(<span class="st">f"{key}: {val}"</span>)

profile(naam=<span class="st">"Ali"</span>, umar=<span class="nm">22</span>, city=<span class="st">"Lahore"</span>)

<span class="cm"># ─── Multiple Return Values ───</span>
<span class="kw">def</span> <span class="fn">minmax</span>(lst):
    <span class="kw">return</span> <span class="bi">min</span>(lst), <span class="bi">max</span>(lst)

lo, hi = minmax([<span class="nm">5</span>, <span class="nm">1</span>, <span class="nm">8</span>, <span class="nm">3</span>])

<span class="cm"># ─── Lambda (Anonymous Function) ───</span>
square  = <span class="kw">lambda</span> x: x ** <span class="nm">2</span>
add_two = <span class="kw">lambda</span> a, b: a + b
<span class="fn">print</span>(square(<span class="nm">6</span>))     <span class="cm"># 36</span>
nums = [<span class="nm">5</span>, <span class="nm">2</span>, <span class="nm">8</span>, <span class="nm">1</span>]
<span class="fn">print</span>(<span class="bi">sorted</span>(nums, key=<span class="kw">lambda</span> x: -x))  <span class="cm"># [8,5,2,1]</span></pre>
  </div>
