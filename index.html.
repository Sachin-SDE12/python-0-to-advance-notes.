<!-- S9: LISTS -->
<div class="section c-green" id="s9">
  <div class="sec-head"><div class="sec-num">09</div><div class="sec-title">Lists — Deep Dive</div><span class="sec-emoji">📋</span></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">lists.py</span></div>
    <pre>lst = [<span class="nm">10</span>, <span class="nm">20</span>, <span class="nm">30</span>, <span class="nm">40</span>, <span class="nm">50</span>]

<span class="cm"># ─── Indexing ───</span>
<span class="fn">print</span>(lst[<span class="nm">0</span>])     <span class="cm"># 10   (pehla)</span>
<span class="fn">print</span>(lst[-<span class="nm">1</span>])    <span class="cm"># 50   (aakhri)</span>
<span class="fn">print</span>(lst[-<span class="nm">2</span>])    <span class="cm"># 40   (aakhir se doosra)</span>

<span class="cm"># ─── Slicing [start:stop:step] ───</span>
<span class="fn">print</span>(lst[<span class="nm">1</span>:<span class="nm">4</span>])       <span class="cm"># [20, 30, 40]</span>
<span class="fn">print</span>(lst[:<span class="nm">3</span>])        <span class="cm"># [10, 20, 30]</span>
<span class="fn">print</span>(lst[<span class="nm">2</span>:])        <span class="cm"># [30, 40, 50]</span>
<span class="fn">print</span>(lst[::-<span class="nm">1</span>])      <span class="cm"># [50,40,30,20,10] (reverse)</span>
<span class="fn">print</span>(lst[::<span class="nm">2</span>])       <span class="cm"># [10, 30, 50] (step 2)</span>

<span class="cm"># ─── Methods ───</span>
lst.append(<span class="nm">60</span>)        <span class="cm"># end mein add</span>
lst.insert(<span class="nm">0</span>, <span class="nm">5</span>)      <span class="cm"># index 0 pe add</span>
lst.extend([<span class="nm">70</span>,<span class="nm">80</span>])  <span class="cm"># doosri list jodo</span>
lst.remove(<span class="nm">20</span>)        <span class="cm"># pehla 20 hatao</span>
lst.pop()              <span class="cm"># aakhri element hatao</span>
lst.pop(<span class="nm">0</span>)            <span class="cm"># index 0 hatao</span>
lst.sort()             <span class="cm"># ascending sort</span>
lst.sort(reverse=<span class="kw">True</span>) <span class="cm"># descending sort</span>
lst.reverse()          <span class="cm"># ulta karo</span>
lst.count(<span class="nm">30</span>)         <span class="cm"># count karo</span>
lst.index(<span class="nm">30</span>)         <span class="cm"># position dhoondo</span>
lst.clear()            <span class="cm"># sab khaali</span>

<span class="cm"># ─── Useful Functions ───</span>
<span class="fn">print</span>(<span class="bi">len</span>(lst))        <span class="cm"># length</span>
<span class="fn">print</span>(<span class="bi">sum</span>(lst))        <span class="cm"># total</span>
<span class="fn">print</span>(<span class="bi">max</span>(lst))        <span class="cm"># max</span>
<span class="fn">print</span>(<span class="bi">min</span>(lst))        <span class="cm"># min</span>
<span class="fn">print</span>(<span class="bi">sorted</span>(lst))     <span class="cm"># naya sorted list</span>

<span class="cm"># ─── List Comprehension ───</span>
squares  = [x**<span class="nm">2</span> <span class="kw">for</span> x <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">1</span>, <span class="nm">6</span>)]
evens    = [x <span class="kw">for</span> x <span class="kw">in</span> <span class="bi">range</span>(<span class="nm">20</span>) <span class="kw">if</span> x % <span class="nm">2</span> == <span class="nm">0</span>]
flat     = [x <span class="kw">for</span> row <span class="kw">in</span> [[<span class="nm">1</span>,<span class="nm">2</span>],[<span class="nm">3</span>,<span class="nm">4</span>]] <span class="kw">for</span> x <span class="kw">in</span> row]

<span class="cm"># ─── Nested List (2D) ───</span>
matrix = [[<span class="nm">1</span>,<span class="nm">2</span>,<span class="nm">3</span>], [<span class="nm">4</span>,<span class="nm">5</span>,<span class="nm">6</span>], [<span class="nm">7</span>,<span class="nm">8</span>,<span class="nm">9</span>]]
<span class="fn">print</span>(matrix[<span class="nm">1</span>][<span class="nm">2</span>])   <span class="cm"># 6</span></pre>
  </div>
</div>

<!-- S10: TUPLES -->
<div class="section c-pink" id="s10">
  <div class="sec-head"><div class="sec-num">10</div><div class="sec-title">Tuples</div><span class="sec-emoji">🔒</span></div>
  <div class="card"><p>Tuple <strong>immutable list</strong> hai — banane ke baad badal nahi sakti. Parentheses <ic>()</ic> use hote hain. List se thodi <strong>faster</strong> hoti hai.</p></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">tuples.py</span></div>
    <pre>colors = (<span class="st">"Red"</span>, <span class="st">"Green"</span>, <span class="st">"Blue"</span>)
point  = (<span class="nm">10</span>, <span class="nm">20</span>)
single = (<span class="nm">42</span>,)      <span class="cm"># single element tuple — comma zaroori!</span>

<span class="cm"># Indexing, slicing (list jaisa)</span>
<span class="fn">print</span>(colors[<span class="nm">0</span>])    <span class="cm"># Red</span>
<span class="fn">print</span>(colors[-<span class="nm">1</span>])   <span class="cm"># Blue</span>

<span class="cm"># Unpacking</span>
x, y = point
r, g, b = colors

<span class="cm"># Extended unpacking</span>
first, *rest = (<span class="nm">1</span>, <span class="nm">2</span>, <span class="nm">3</span>, <span class="nm">4</span>, <span class="nm">5</span>)
<span class="fn">print</span>(first)   <span class="cm"># 1</span>
<span class="fn">print</span>(rest)    <span class="cm"># [2, 3, 4, 5]</span>

<span class="cm"># Named tuple (dictionary + tuple ka combo)</span>
<span class="kw">from</span> collections <span class="kw">import</span> namedtuple
Point = namedtuple(<span class="st">'Point'</span>, [<span class="st">'x'</span>, <span class="st">'y'</span>])
p = Point(<span class="nm">3</span>, <span class="nm">4</span>)
<span class="fn">print</span>(p.x, p.y)    <span class="cm"># 3 4</span></pre>
  </div>
</div>

<!-- S11: DICTIONARY -->
<div class="section c-purple" id="s11">
  <div class="sec-head"><div class="sec-num">11</div><div class="sec-title">Dictionary</div><span class="sec-emoji">📖</span></div>
  <div class="cb">
    <div class="cb-top"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div><span class="cb-file">dict.py</span></div>
    <pre>student = {
    <span class="st">"naam"</span>  : <span class="st">"Sachin"</span>,
    <span class="st">"umar"</span>  : <span class="nm">20</span>,
    <span class="st">"marks"</span> : <span class="nm">88.5</span>,
    <span class="st">"hobbies"</span>: [<span class="st">"Cricket"</span>, <span class="st">"Coding"</span>]
}

<span class="cm"># Access</span>
<span class="fn">print</span>(student[<span class="st">"naam"</span>])              <span class="cm"># Sachin</span>
<span class="fn">print</span>(student.get(<span class="st">"city"</span>, <span class="st">"N/A"</span>)) <span class="cm"># N/A (key nahi toh default)</span>

<span class="cm"># Add / Update</span>
student[<span class="st">"city"</span>] = <span class="st">"Delhi"</span>
student.update({<span class="st">"marks"</span>: <span class="nm">92</span>, <span class="st">"grade"</span>: <span class="st">"A"</span>})

<span class="cm"># Delete</span>
<span class="kw">del</span> student[<span class="st">"umar"</span>]
val = student.pop(<span class="st">"city"</span>)

<span class="cm"># Loop</span>
<span class="kw">for</span> key <span class="kw">in</span> student:               <span class="cm"># keys</span>
    <span class="fn">print</span>(key)
<span class="kw">for</span> key, val <span class="kw">in</span> student.items():  <span class="cm"># key-value dono</span>
    <span class="fn">print</span>(<span class="st">f"{key} → {val}"</span>)

<span class="cm"># Check</span>
<span class="fn">print</span>(<span class="st">"naam"</span> <span class="kw">in</span> student)    <span class="cm"># True</span>
<span class="fn">print</span>(<span class="bi">len</span>(student))         <span class="cm"># number of keys</span>

