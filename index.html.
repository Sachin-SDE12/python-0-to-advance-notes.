<span class="kw">else</span>:
    <span class="fn">print</span>(<span class="st">"✅ Koi error nahi!"</span>)
<span class="kw">finally</span>:
    <span class="fn">print</span>(<span class="st">"Yeh hamesha chalega 🔁"</span>)

<span class="cm"># ─── Common Exceptions ───</span>
<span class="cm"># ValueError      — galat type input</span>
<span class="cm"># TypeError       — wrong data type</span>
<span class="cm"># IndexError      — list index out of range</span>
<span class="cm"># KeyError        — dict mein key nahi</span>
<span class="cm"># FileNotFoundError — file nahi mili</span>
<span class="cm"># ZeroDivisionError — zero se divide</span>
<span class="cm"># AttributeError  — attribute nahi mila</span>

<span class="cm"># ─── Custom Exception ───</span>
<span class="kw">class</span> <span class="cl">AgeError</span>(<span class="bi">Exception</span>):
    <span class="kw">def</span> <span class="fn">__init__</span>(<span class="kw">self</span>, umar):
        <span class="bi">super</span>().__init__(<span class="st">f"Galat umar: {umar}. 0-150 ke beech honi chahiye."</span>)

<span class="kw">def</span> <span class="fn">set_age</span>(age):
    <span class="kw">if</span> age < <span class="nm">0</span> <span class="kw">or</span> age > <span class="nm">150</span>:
        <span class="kw">raise</span> <span class="cl">AgeError</span>(age)
    <span class="fn">print</span>(<span class="st">f"Age set: {age}"</span>)

<span class="kw">try</span>:
    set_age(<span class="nm">200</span>)
<span class="kw">except</span> <span class="cl">AgeError</span> <span class="kw">as</span> e:
    <span class="fn">print</span>(<span class="st">f"Error: {e}"</span>)</pre>
